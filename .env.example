NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gnkalgo
COOKIE_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxx
DATA_KEYRING_JSON={"v1":"REPLACE_WITH_32_BYTE_BASE64_KEY"}
ACTIVE_DATA_KEY_VERSION=v1
# Mandatory in production; its public IPv4 must be broker-whitelisted.
BROKER_HTTPS_PROXY=http://proxy.internal:3128
BROKER_CONFIG_JSON={"upstox":{"clientId":"x","clientSecret":"x","authorizeUrl":"https://api.upstox.com/v2/login/authorization/dialog","tokenUrl":"https://api.upstox.com/v2/login/authorization/token","scopes":[]},"zerodha":{"clientId":"x","clientSecret":"x","authorizeUrl":"https://kite.zerodha.com/connect/login?v=3","tokenUrl":"https://api.kite.trade/session/token","scopes":[]}}
